{
  "opencollection": "1.0.0",
  "info": {
    "name": "PlayAI Agents Conversations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AUTHORIZATION",
      "value": "{{AUTHORIZATION}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List agent conversations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.play.ai/api/v1/agents/:agentId/conversations",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List agent conversations"
        },
        {
          "info": {
            "name": "Get conversation transcript",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.play.ai/api/v1/agents/:agentId/conversations/:conversationId/transcript",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "conversationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get conversation transcript"
        }
      ]
    }
  ],
  "bundled": true
}